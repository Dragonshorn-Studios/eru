# Bind all interfaces in Compose. Locally you can use 127.0.0.1.
ERU_HOST=0.0.0.0
ERU_PORT=3000

# SQLite path. The database file is not committed.
ERU_SQLITE_PATH=./data/eru.sqlite

# Shared operator UI password. Required. Replace this placeholder. Never commit a real value.
ERU_UI_PASSWORD=change-me

# HMAC secret for the signed UI session cookie. Required. Use 16+ random bytes. Never commit a real value.
ERU_UI_SESSION_SECRET=change-me-session

# OpenCode binary used by Ask. Required for /ask to work; missing or failing
# binaries fail closed with an operator-facing notice.
ERU_OPENCODE_BIN=opencode

# OpenCode timeout per question in milliseconds (1s - 10min).
#ERU_OPENCODE_TIMEOUT_MS=120000

# Optional model override (provider/model).
#ERU_OPENCODE_MODEL=
