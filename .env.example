# Bind all interfaces in Compose. Locally you can use 127.0.0.1.
ERU_HOST=0.0.0.0
ERU_PORT=3000

# SQLite path. The database file is not committed.
ERU_SQLITE_PATH=./data/eru.sqlite

# Shared operator UI password. Required. Replace this placeholder. Never commit a real value.
ERU_UI_PASSWORD=change-me

# HMAC secret for the signed UI session cookie. Required. Use 16+ random bytes. Never commit a real value.
ERU_UI_SESSION_SECRET=change-me-session

# Optional dedicated key for encrypting forge tokens. Without it tokens are
# encrypted under the session secret — rotating ERU_UI_SESSION_SECRET then
# bricks stored credentials. Set a stable 32+ byte secret to keep tokens
# decryptable across session-secret rotation. Decrypt tries every configured
# key, so adding this later keeps older rows readable.
#ERU_FORGE_TOKEN_KEY=

# OpenCode binary used by Ask. Required for /ask to work; missing or failing
# binaries fail closed with an operator-facing notice.
ERU_OPENCODE_BIN=opencode

# OpenCode timeout per question in milliseconds (1s - 10min).
# Also settable on /config — a saved value overrides this env var.
#ERU_OPENCODE_TIMEOUT_MS=120000

# Optional model override (provider/model) for both Ask and map refresh.
#ERU_OPENCODE_MODEL=

# Optional per-purpose model overrides. Used when nothing is saved on /config
# and over ERU_OPENCODE_MODEL.
#ERU_OPENCODE_ASK_MODEL=
#ERU_OPENCODE_MAP_MODEL=

# Root for per-thread Ask workspaces (each holds a map snapshot + a
# deny-by-default opencode.json). Defaults to <sqlite dir>/ask — on the
# eru-data volume under Compose, so threads survive restarts.
#ERU_ASK_WORKDIR=

# GitHub App (optional) — one App covers mapping, Sign in with GitHub, and
# @eru-issue-bot. Permissions: Contents read, Issues read/write, Metadata
# read. Subscribe to Issues. Callback URL must be exactly
# $ERU_PUBLIC_URL/login/github/callback. All of this is also settable on
# /config (saved values win; no restart). App ID is a number from the
# app's GitHub settings page; the key is the app's PEM (inline with \n
# escapes, or a file).
# ERU_GITHUB_APP_ID=
# ERU_GITHUB_APP_PRIVATE_KEY=
# ERU_GITHUB_APP_PRIVATE_KEY_FILE=
# Optional: pin one installation; otherwise a single installation auto-detects.
# ERU_GITHUB_APP_INSTALLATION_ID=
# OAuth identity (same App). ERU_OAUTH_* names remain aliases.
# ERU_GITHUB_APP_CLIENT_ID=
# ERU_GITHUB_APP_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids allowed to sign in.
# ERU_GITHUB_APP_ADMIN_IDS=
# Webhook HMAC secret for POST /webhooks/github (16+ bytes). Also accepted
# as ERU_ISSUE_BOT_WEBHOOK_SECRET.
# ERU_GITHUB_APP_WEBHOOK_SECRET=
# GitHub user id of your-app[bot] — loop guard. Find it at
# https://api.github.com/users/your-app%5Bbot%5D
# ERU_GITHUB_APP_BOT_USER_ID=

# Dedicated issue-bot App (optional). Set ALL of App ID, PEM, webhook secret,
# and bot user id — mixing a dedicated App ID with the mapping App's PEM or
# webhook secret fails closed at boot. Omit these to reuse the mapping App
# (ERU_ISSUE_BOT_WEBHOOK_SECRET / ERU_ISSUE_BOT_USER_ID remain aliases then).
# ERU_ISSUE_BOT_APP_ID=
# ERU_ISSUE_BOT_PRIVATE_KEY=
# ERU_ISSUE_BOT_PRIVATE_KEY_FILE=
# ERU_ISSUE_BOT_WEBHOOK_SECRET=
# ERU_ISSUE_BOT_USER_ID=
# Comma-separated GitHub user ids allowed to trigger a rewrite even when
# author_association is not OWNER/MEMBER/COLLABORATOR (e.g. a trusted bot).
# ERU_TRUSTED_BOT_IDS=
# Max refine jobs enqueued per owner/repo per hour. Default 20.
# ERU_ISSUE_BOT_HOURLY_CAP=20

# Self-hosted GitLab (optional). URL + token list/read repos and map them.
# Webhook secret turns on @eru-issue-bot at POST /webhooks/gitlab
# (X-Gitlab-Token). Also settable on /config. Never commit real values.
# ERU_GITLAB_URL=
# ERU_GITLAB_TOKEN=
# ERU_GITLAB_WEBHOOK_SECRET=

# Self-hosted Forgejo / Gitea (optional). Token header is `Authorization:
# token …`. Webhook HMAC at POST /webhooks/forgejo
# (X-Hub-Signature-256 / X-Gitea-Signature). Also settable on /config.
# ERU_FORGEJO_URL=
# ERU_FORGEJO_TOKEN=
# ERU_FORGEJO_WEBHOOK_SECRET=

# Operator name shown in the top bar — must be a GitHub login; its public
# github.com avatar appears in the user pill. Blank = "operator" monogram.
#ERU_UI_USER=

# GitHub OAuth login aliases (optional). Prefer ERU_GITHUB_APP_CLIENT_* above
# so one App covers login. Authorization callback URL must be exactly
# $ERU_PUBLIC_URL/login/github/callback. With OAuth on, only allowlisted
# GitHub user ids can sign in, and ERU_PUBLIC_URL is required.
# ERU_OAUTH_CLIENT_ID=
# ERU_OAUTH_CLIENT_SECRET=
# ERU_OAUTH_ADMIN_IDS=
# Public URL where operators reach Eru — used to build the OAuth callback.
# ERU_PUBLIC_URL=
# Keep the shared-password form alongside GitHub sign-in. Default off when
# OAuth is configured.
# ERU_UI_LOCAL_LOGIN=

# XDG data dir — OpenCode's auth.json (provider API keys saved on /config)
# lands at $XDG_DATA_HOME/opencode/auth.json. Defaults to ~/.local/share.
#XDG_DATA_HOME=
